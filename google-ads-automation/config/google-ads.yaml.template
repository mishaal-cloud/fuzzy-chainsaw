# Google Ads API Configuration Template
# Copy this file to google-ads.yaml and fill in your credentials
# Get credentials from: https://developers.google.com/google-ads/api/docs/first-call/overview

developer_token: "YOUR_DEVELOPER_TOKEN"
client_id: "YOUR_CLIENT_ID.apps.googleusercontent.com"
client_secret: "YOUR_CLIENT_SECRET"
refresh_token: "YOUR_REFRESH_TOKEN"
login_customer_id: "YOUR_MANAGER_ACCOUNT_ID"  # Without hyphens, e.g., 1234567890
use_proto_plus: True
