# Database - Get from Vercel Postgres dashboard
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"

# NextAuth - Generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# GitHub OAuth - Create at: https://github.com/settings/developers
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# OpenAI API - Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key"

# Vercel Blob Storage - Auto-configured when you connect Vercel Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_token"

# Resend Email API - Get from: https://resend.com/api-keys
RESEND_API_KEY="re_your-resend-api-key"
RESEND_FROM_EMAIL="TaskMaster Pro <onboarding@resend.dev>"

# App Configuration
NODE_ENV="development"
