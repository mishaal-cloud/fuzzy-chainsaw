# ============================================
# .env.example — Template for all required variables
# Copy to .env and fill in your values
# ============================================

# --- n8n Cloud ---
N8N_API_KEY=
N8N_INSTANCE_URL=https://your-instance.app.n8n.cloud
N8N_MCP_KEY_ID=

# --- Google Ads ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=

# --- Google Analytics ---
GA4_PROPERTY_ID=
GA4_ACCOUNT_ID=

# --- Google Search Console ---
GSC_SITE_URL=

# --- SEMrush ---
SEMRUSH_API_KEY=

# --- Apollo.io ---
APOLLO_API_KEY=

# --- Gong ---
GONG_BASE_URL=
GONG_ACCESS_KEY=
GONG_CLIENT_SECRET=

# --- FRED ---
FRED_API_KEY=

# --- US Census Bureau ---
CENSUS_API_KEY=

# --- Financial Modeling Prep ---
FMP_API_KEY=

# --- NewsAPI.ai ---
NEWSAPI_AI_KEY=

# --- QuickBooks / Intuit ---
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# --- Supabase ---
SUPABASE_DB_PASSWORD=

# --- Microsoft Clarity ---
CLARITY_API_TOKEN=

# --- HubSpot ---
HUBSPOT_ACCESS_TOKEN=

# --- Alert Email ---
ALERT_EMAIL=

