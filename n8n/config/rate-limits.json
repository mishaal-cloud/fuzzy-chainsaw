  "global": {
    "max_concurrent_requests": 50,
    "queue_max_size": 1000,
    "queue_timeout_seconds": 30,
    "circuit_breaker": {
      "failure_threshold": 5,
      "recovery_timeout_seconds": 60,
      "half_open_max_requests": 3
    },
    "monitoring": {
      "track_usage": true,
      "alert_threshold_percent": 80,
      "alert_channels": ["slack", "email"],
      "usage_reset_time_utc": "00:00"
    }
  },
  "throttle_strategies": {
    "sliding_window": {
      "description": "Tracks requests in a rolling time window for smooth rate limiting",
      "window_size_seconds": 60
    },
    "token_bucket": {
      "description": "Allows bursts up to bucket capacity, refills at steady rate",
      "refill_interval_ms": 1000
    },
    "fixed_window": {
      "description": "Resets counter at fixed intervals, simplest strategy",
      "window_size_seconds": 86400
    },
    "leaky_bucket": {
      "description": "Processes requests at a fixed rate, queues excess",
      "drain_interval_ms": 500
    }
  }
