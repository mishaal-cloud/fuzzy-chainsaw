    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\n// Validate required fields\nconst errors = [];\nif (!body.client) errors.push('Missing required field: client');\nif (!body.api) errors.push('Missing required field: api');\nif (!body.action) errors.push('Missing required field: action');\n\nif (errors.length > 0) {\n  return [{\n    json: {\n      error: true,\n      status_code: 400,\n      message: 'Invalid request',\n      validation_errors: errors,\n      usage: 'POST /api-gateway with body: { client: \"string\", api: \"string\", action: \"string\", params: {} }'\n    }\n  }];\n}\n\n// Normalize and enrich\nreturn [{\n  json: {\n    request_id: $execution.id,\n    timestamp: new Date().toISOString(),\n    client: body.client.toLowerCase().trim(),\n    api: body.api.toLowerCase().trim(),\n    action: body.action.toLowerCase().trim(),\n    params: body.params || {},\n    raw_body: body\n  }\n}];"
      },
      "id": "a1b2c3d4-2222-4000-8000-000000000002",
      "name": "Validate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 300]
    },
    {
