    {
      "parameters": {
        "jsCode": "const api = $json.api;\n\nconst routingTable = {\n  // Marketing Ads\n  google_ads: 'marketing_ads',\n  meta_ads: 'marketing_ads',\n  facebook_ads: 'marketing_ads',\n  linkedin_ads: 'marketing_ads',\n  tiktok_ads: 'marketing_ads',\n\n  // CRM\n  hubspot: 'crm',\n  salesforce: 'crm',\n  pipedrive: 'crm',\n\n  // Analytics\n  ga4: 'analytics',\n  google_analytics: 'analytics',\n  search_console: 'analytics',\n\n  // Google Suite\n  gmail: 'google_suite',\n  calendar: 'google_suite',\n  google_calendar: 'google_suite',\n  drive: 'google_suite',\n  google_drive: 'google_suite',\n  sheets: 'google_suite',\n  google_sheets: 'google_suite'\n};\n\nconst category = routingTable[api];\nif (!category) {\n  return [{\n    json: {\n      error: true,\n      status_code: 404,\n      message: `Unknown API: ${api}`,\n      available_apis: Object.keys(routingTable),\n      suggestion: 'Call GET /api-discovery for the full API catalog'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...$json,\n    routeTo: category\n  }\n}];"
      },
